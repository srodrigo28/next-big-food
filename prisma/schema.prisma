// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String @id @default(uuid())
  name           String @unique
  slug           String @unique
  description    String
  avatarImageUrl String
  coverImageUrl  String

  menuCategories MenuCategory[]
  products       Product[]
  orders         Order[]
  tables         RestaurantTable[]
  users          RestaurantUser[]
  ingredients    Ingredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  imageUrl    String
  ingredients String[]
  isAvailable Boolean  @default(true)

  orderProducts      OrderProduct[]
  productIngredients ProductIngredient[]
  productAddons      ProductAddon[]

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuCategoryId String
  menuCategory   MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id Int @id @default(autoincrement())

  total             Float
  status            OrderStatus       @default(PENDING)
  consumptionMethod ConsumptionMethod
  restaurantId      String
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderProducts     OrderProduct[]
  customerName      String?
  customerCpf       String?
  tableId           String?
  table             RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  asaasChargeId      String?
  pixExpiresAt       DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  restaurants  RestaurantUser[]
  sessions     AdminSession[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model RestaurantUser {
  id           String     @id @default(uuid())
  role         AdminRole  @default(OWNER)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, restaurantId])
}

model AdminSession {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model RestaurantTable {
  id           String      @id @default(uuid())
  name         String
  code         String
  status       TableStatus @default(AVAILABLE)
  seats        Int?
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, code])
}

model OrderProduct {
  id String @id @default(uuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  Int
  quantity Int
  price    Float

  customization OrderProductCustomization?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  READY
  DELIVERED
  FINISHED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  WAITING_ORDER
  IN_SERVICE
  WAITING_PAYMENT
}

enum AdminRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum ConsumptionMethod {
  TAKEAWAY
  DINE_IN
}

enum AllergyType {
  LACTOSE
  GLUTEN
  PEANUT
  NUTS
  EGG
  SOY
  FISH
  SHELLFISH
  COLORANTS
  OTHER
}

model Ingredient {
  id           String       @id @default(uuid())
  name         String
  description  String?
  isAllergen   Boolean      @default(false)
  allergenType AllergyType?
  isActive     Boolean      @default(true)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  productIngredients             ProductIngredient[]
  removedFromOrderCustomizations OrderProductRemovedIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductIngredient {
  id        String  @id @default(uuid())
  canRemove Boolean @default(false)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String

  @@unique([productId, ingredientId])
}

model ProductAddon {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  maxQuantity Int     @default(1)
  isActive    Boolean @default(true)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  orderAddons OrderProductAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderProductCustomization {
  id           String        @id @default(uuid())
  observation  String?
  hasAllergy   Boolean       @default(false)
  allergyNotes String?
  allergyTypes AllergyType[]

  orderProduct   OrderProduct @relation(fields: [orderProductId], references: [id], onDelete: Cascade)
  orderProductId String       @unique

  removedIngredients OrderProductRemovedIngredient[]
  addons             OrderProductAddon[]
}

model OrderProductRemovedIngredient {
  id           String @id @default(uuid())
  nameSnapshot String

  customization   OrderProductCustomization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  customizationId String

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String
}

model OrderProductAddon {
  id                String @id @default(uuid())
  nameSnapshot      String
  quantity          Int
  unitPriceSnapshot Float
  total             Float

  customization   OrderProductCustomization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  customizationId String

  productAddon   ProductAddon @relation(fields: [productAddonId], references: [id], onDelete: Restrict)
  productAddonId String
}
